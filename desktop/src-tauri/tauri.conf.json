{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataPyn Tauri",
  "version": "1.0.4",
  "identifier": "app.datapyn.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "title": "DataPyn",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#101725"
      },
      {
        "label": "splash",
        "create": false,
        "url": "splash.html",
        "title": "DataPyn",
        "width": 640,
        "height": 420,
        "center": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "backgroundColor": "#081018"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "SQL and Python workspace",
    "category": "DeveloperTool",
    "fileAssociations": [
      {
        "ext": [
          "dpw"
        ],
        "name": "DataPyn workspace",
        "description": "SQL and Python workspace",
        "role": "Editor",
        "mimeType": "application/x-datapyn-tauri-workspace"
      },
      {
        "ext": [
          "sql"
        ],
        "name": "SQL script",
        "description": "SQL script",
        "role": "Editor",
        "mimeType": "application/sql"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBNjI0MUY1M0EyRDVFRUEKUldUcVhpMDY5VUZpaXJDMHI3MnU1dFFXQVZpMzJGaVl4YkVYdVdjQ2d5YWVnN1FCTm9CUVFwcDgK",
      "endpoints": [
        "https://github.com/natharuc/datapyn/releases/download/tauri-stable/latest.json"
      ]
    }
  }
}
