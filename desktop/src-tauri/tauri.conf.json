{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataPyn Tauri",
  "version": "1.57.0",
  "identifier": "app.datapyn.desktop.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "title": "DataPyn — Prévia Tauri",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#101725"
      },
      {
        "label": "splash",
        "create": false,
        "url": "splash.html",
        "title": "DataPyn",
        "width": 640,
        "height": 420,
        "center": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "backgroundColor": "#081018"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": ["../../source/src/assets/datapyn-logo.ico", "icons/256x256.png"]
  },
  "plugins": {
    "updater": { "pubkey": "", "endpoints": [] }
  }
}
