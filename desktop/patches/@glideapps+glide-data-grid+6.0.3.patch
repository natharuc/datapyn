+import * as React from "react";
+
+// An adopted grid belongs to its host document, rather than the module's realm.
+export const OwnerDocumentContext = React.createContext(undefined);
+export function ownerDocumentOf(element, fallback) {
+    return element?.ownerDocument ?? fallback ?? (typeof document === "undefined" ? undefined : document);
+}
+export function ownerWindowOf(ownerDocument) {
+    return ownerDocument?.defaultView ?? (typeof window === "undefined" ? undefined : window);
+}
+export function useOwnerDocument() {
+    return ownerDocumentOf(undefined, React.useContext(OwnerDocumentContext));
+}
+export function useOwnerWindow() {
+    return ownerWindowOf(useOwnerDocument());
+}
+export function isMouseEvent(event) {
+    // instanceof against the importing window rejects real events from popouts.
+    return event !== undefined && typeof event.clientX === "number" && typeof event.clientY === "number" && !("changedTouches" in event);
+}
+export function isGridFocused(scroll, canvas) {
+    const document = ownerDocumentOf(scroll ?? canvas);
+    const active = document?.activeElement;
+    return active != null && (scroll?.contains(active) === true || canvas?.contains(active) === true);
+}
+export function overlayPortal(document) {
+    let portal = document.getElementById("portal");
+    if (portal === null) {
+        portal = document.createElement("div");
+        portal.id = "portal";
+        portal.dataset.gdgPortal = "true";
+        document.body.append(portal);
+    }
+    return portal;
+}
