+# ===== Drag & Drop para criar blocos =====
+
+
+class TestDragDropCreateBlock:
+    """Testes para drag & drop de conexao/banco na area vazia do editor cria novo bloco SQL"""
+
+    def test_drag_enter_accepts_connection_name(self, qapp):
+        """dragEnterEvent deve aceitar mime application/x-connection-name"""
+        editor = BlockEditor()
+
+        mime_data = QMimeData()
+        mime_data.setData("application/x-connection-name", b"TestConn")
+
+        event = MagicMock()
+        event.mimeData.return_value = mime_data
+        editor.dragEnterEvent(event)
+        event.acceptProposedAction.assert_called_once()
+
+    def test_drag_enter_accepts_database_name(self, qapp):
+        """dragEnterEvent deve aceitar mime application/x-database-name"""
+        editor = BlockEditor()
+
+        mime_data = QMimeData()
+        mime_data.setData("application/x-database-name", b"mydb")
+
+        event = MagicMock()
+        event.mimeData.return_value = mime_data
+        editor.dragEnterEvent(event)
+        event.acceptProposedAction.assert_called_once()
+
+    def test_drag_enter_rejects_unrelated_mime(self, qapp):
+        """dragEnterEvent nao deve aceitar mime irrelevante"""
+        editor = BlockEditor()
+
+        mime_data = QMimeData()
+        mime_data.setData("application/x-random-stuff", b"nope")
+
+        event = MagicMock()
+        event.mimeData.return_value = mime_data
+        editor.dragEnterEvent(event)
+        event.acceptProposedAction.assert_not_called()
+
+    def test_drop_connection_creates_sql_block(self, qapp):
+        """Drop de conexao no editor deve criar bloco SQL com conexao definida"""
+        editor = BlockEditor()
+        initial_count = len(editor._blocks)
+
+        mime_data = QMimeData()
+        mime_data.setData("application/x-connection-name", b"ProdConn")
+        mime_data.setData("application/x-db-type", b"mysql")
+
+        event = MagicMock()
+        event.mimeData.return_value = mime_data
+        editor.dropEvent(event)
+
+        assert len(editor._blocks) == initial_count + 1
+        new_block = editor._blocks[-1]
+        assert new_block.get_language() == "sql"
+        assert new_block.get_connection_name() == "ProdConn"
+        assert new_block.conn_panel._db_type == "mysql"
+        event.acceptProposedAction.assert_called_once()
+
+    def test_drop_connection_with_color(self, qapp):
+        """Drop de conexao com cor deve propagar para o bloco"""
+        editor = BlockEditor()
+
+        mime_data = QMimeData()
+        mime_data.setData("application/x-connection-name", b"ColorConn")
+        mime_data.setData("application/x-db-type", b"postgresql")
+        mime_data.setData("application/x-connection-color", b"#ff5500")
+
+        event = MagicMock()
+        event.mimeData.return_value = mime_data
+        editor.dropEvent(event)
+
+        new_block = editor._blocks[-1]
+        assert new_block.get_connection_name() == "ColorConn"
+        assert new_block.conn_panel._db_type == "postgresql"
+
+    def test_drop_database_creates_sql_block_with_db(self, qapp):
+        """Drop de banco (do Object Explorer) deve criar bloco SQL com banco definido"""
+        editor = BlockEditor()
+        initial_count = len(editor._blocks)
+
+        mime_data = QMimeData()
+        mime_data.setData("application/x-database-name", b"northwind")
+        mime_data.setData("application/x-connection-name", b"ServerConn")
+
+        event = MagicMock()
+        event.mimeData.return_value = mime_data
+        editor.dropEvent(event)
+
+        assert len(editor._blocks) == initial_count + 1
+        new_block = editor._blocks[-1]
+        assert new_block.get_language() == "sql"
+        assert new_block.get_connection_name() == "ServerConn"
+        assert new_block.get_database_name() == "northwind"
+        event.acceptProposedAction.assert_called_once()
+
+    def test_drop_database_only_creates_block(self, qapp):
+        """Drop somente de banco (sem conexao) deve criar bloco com banco"""
+        editor = BlockEditor()
+        initial_count = len(editor._blocks)
+
+        mime_data = QMimeData()
+        mime_data.setData("application/x-database-name", b"staging_db")
+
+        event = MagicMock()
+        event.mimeData.return_value = mime_data
+        editor.dropEvent(event)
+
+        assert len(editor._blocks) == initial_count + 1
+        new_block = editor._blocks[-1]
+        assert new_block.get_language() == "sql"
+        assert new_block.get_connection_name() is None
+        assert new_block.get_database_name() == "staging_db"
+
+    def test_drop_emits_content_changed(self, qapp):
+        """Drop de conexao deve emitir content_changed"""
+        editor = BlockEditor()
+        changed = []
+        editor.content_changed.connect(lambda: changed.append(True))
+
+        mime_data = QMimeData()
