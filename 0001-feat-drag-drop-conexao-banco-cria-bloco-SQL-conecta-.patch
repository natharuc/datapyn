+    def _check_database_changed(self):
+        """Compares current database with db_before execution.
+
+        If the database changed (e.g. via USE command), emits connection_changed
+        and updates the focused block's db_panel.
+        """
+        connector = getattr(self, "_current_connector", None)
+        conn_name = getattr(self, "_current_connection_name", None)
+        db_before = getattr(self, "_db_before", "")
+
+        if not connector or not conn_name:
+            return
+
+        try:
+            db_after = connector.get_current_database()
+        except Exception:
+            return
+
+        if not db_after or not db_before:
+            return
+
+        if db_after.lower() != db_before.lower():
+            # Database changed - update UI
+            self.connection_changed.emit(conn_name, db_after)
+
+            # Update focused block's db_panel
+            focused_block = self.editor.get_focused_block()
+            if not focused_block:
+                focused_block = self.editor.get_last_focused_block()
+            if focused_block and hasattr(focused_block, "db_panel"):
+                focused_block._database_name = db_after
+                focused_block.db_panel.set_database(db_after)
+
