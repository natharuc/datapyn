diff --git a/tests/test_block_connection.py b/tests/test_block_connection.py
index a7f157c..1f734c1 100644
--- a/tests/test_block_connection.py
+++ b/tests/test_block_connection.py
@@ -601,3 +601,259 @@ class TestQueueProcessing:
